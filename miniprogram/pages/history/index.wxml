<view class="page-history {{themeClass}}">
  <!-- 功能入口 -->
  <view class="entry-grid">
    <view class="entry-item" bindtap="goAnnualReport">
      <text class="entry-icon">📊</text>
      <text class="entry-text">年度报告</text>
    </view>
    <view class="entry-item" bindtap="goInsights">
      <text class="entry-icon">💡</text>
      <text class="entry-text">数据洞察</text>
    </view>
  </view>

  <!-- 目标筛选 -->
  <view class="goal-filter" wx:if="{{goals.length > 0}}">
    <scroll-view scroll-x class="filter-scroll">
      <view class="filter-item {{selectedGoalId === '' ? 'active' : ''}}" bindtap="selectGoal" data-goal-id="">
        <text>全部</text>
      </view>
      <view
        class="filter-item {{selectedGoalId === item.id ? 'active' : ''}}"
        wx:for="{{goals}}"
        wx:key="id"
        bindtap="selectGoal"
        data-goal-id="{{item.id}}"
      >
        <text class="filter-icon">{{item.icon}}</text>
        <text>{{item.name}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 统计视图切换 -->
  <view class="stats-tabs">
    <view class="stats-tab {{statsView === 'week' ? 'active' : ''}}" bindtap="switchStatsView" data-view="week">
      <text>本周</text>
    </view>
    <view class="stats-tab {{statsView === 'month' ? 'active' : ''}}" bindtap="switchStatsView" data-view="month">
      <text>本月</text>
    </view>
    <view class="stats-tab {{statsView === 'trend' ? 'active' : ''}}" bindtap="switchStatsView" data-view="trend">
      <text>趋势</text>
    </view>
  </view>

  <!-- ==================== 本周视图 ==================== -->
  <block wx:if="{{statsView === 'week'}}">
    <!-- 本周统计卡片 -->
    <view class="stats-card card">
      <view class="stats-header">
        <text class="stats-title">本周统计</text>
        <text class="stats-month">{{weekRange}}</text>
      </view>
      <view class="stats-grid">
        <view class="stat-item">
          <text class="stat-value">{{weekCheckins}}</text>
          <text class="stat-label">打卡天数</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{weekRate}}%</text>
          <text class="stat-label">完成率</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{currentStreak}}</text>
          <text class="stat-label">连续天数</text>
        </view>
      </view>
      <!-- 本周每日打卡 -->
      <view class="week-chart">
        <view class="week-day" wx:for="{{weekData}}" wx:key="date">
          <view class="week-bar-track">
            <view class="week-bar-fill {{item.checked ? 'active' : ''}}" style="height: {{item.checked ? '100%' : '20%'}};"></view>
          </view>
          <text class="week-day-label {{item.isToday ? 'today' : ''}}">{{item.day}}</text>
        </view>
      </view>
    </view>

    <!-- 挑战统计（全部模式） -->
    <view class="challenge-section" wx:if="{{challengeStats && !selectedGoalId}}">
      <view class="section-header">
        <text class="section-title">挑战统计</text>
      </view>
      <view class="challenge-overview card">
        <view class="co-item">
          <text class="co-value">{{challengeStats.totalChallenges}}</text>
          <text class="co-label">总挑战数</text>
        </view>
        <view class="co-divider"></view>
        <view class="co-item">
          <text class="co-value">{{challengeStats.completedChallenges}}</text>
          <text class="co-label">已完成</text>
        </view>
        <view class="co-divider"></view>
        <view class="co-item">
          <text class="co-value">{{challengeStats.activeChallenges}}</text>
          <text class="co-label">进行中</text>
        </view>
      </view>
    </view>

    <!-- 目标挑战情况（筛选模式） -->
    <view class="goal-challenge-section" wx:if="{{goalChallenges && selectedGoalId}}">
      <view class="section-header">
        <text class="section-title">{{goalChallenges.goalIcon}} {{goalChallenges.goalName}} 挑战</text>
      </view>
      <view class="goal-challenge-overview card" wx:if="{{goalChallenges.totalChallenges > 0}}">
        <view class="gco-item">
          <text class="gco-value">{{goalChallenges.totalChallenges}}</text>
          <text class="gco-label">总挑战</text>
        </view>
        <view class="gco-item">
          <text class="gco-value">{{goalChallenges.completedChallenges}}</text>
          <text class="gco-label">已完成</text>
        </view>
        <view class="gco-item">
          <text class="gco-value">{{goalChallenges.activeChallenges}}</text>
          <text class="gco-label">进行中</text>
        </view>
      </view>
    </view>
  </block>

  <!-- ==================== 本月视图 ==================== -->
  <block wx:if="{{statsView === 'month'}}">
    <!-- 本月统计卡片 -->
    <view class="stats-card card">
      <view class="stats-header">
        <text class="stats-title">{{selectedGoalId ? '目标统计' : '本月打卡统计'}}</text>
        <text class="stats-month">{{currentMonth}}</text>
      </view>
      <view class="stats-grid">
        <view class="stat-item">
          <text class="stat-value">{{monthCheckins}}</text>
          <text class="stat-label">打卡天数</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{currentStreak}}</text>
          <text class="stat-label">连续天数</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{longestStreak}}</text>
          <text class="stat-label">最长连续</text>
        </view>
      </view>
    </view>

    <!-- 各目标统计（全部模式） -->
    <view class="goal-stats-section" wx:if="{{!selectedGoalId && goalStats.length > 0}}">
      <view class="section-header">
        <text class="section-title">各目标统计</text>
      </view>
      <view class="goal-stat-list">
        <view class="goal-stat-item card" wx:for="{{goalStats}}" wx:key="id">
          <view class="goal-stat-left">
            <view class="goal-stat-icon" style="background: {{item.color}}20;">
              <text>{{item.icon}}</text>
            </view>
            <view class="goal-stat-info">
              <text class="goal-stat-name">{{item.name}}</text>
              <text class="goal-stat-detail">连续{{item.currentStreak}}天 · 累计{{item.totalDays}}天</text>
            </view>
          </view>
          <view class="goal-stat-streak">
            <text class="streak-value">{{item.longestStreak}}</text>
            <text class="streak-label">最长连续</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 时长分析（筛选时长目标时） -->
    <view class="duration-section" wx:if="{{durationStats && selectedGoalId && selectedGoalType === 'duration'}}">
      <view class="section-header">
        <text class="section-title">时长分析</text>
        <text class="section-sub">{{durationStats.days}}天总览</text>
      </view>
      <view class="dur-overview card">
        <view class="dur-ov-item">
          <text class="dur-ov-value">{{durationStats.grandTotalStr}}</text>
          <text class="dur-ov-label">总投入时长</text>
        </view>
        <view class="dur-ov-divider"></view>
        <view class="dur-ov-item">
          <text class="dur-ov-value">{{durationStats.goalDistribution.length}}</text>
          <text class="dur-ov-label">时长目标</text>
        </view>
      </view>
    </view>

    <!-- 计数分析（筛选计数目标时） -->
    <view class="count-section" wx:if="{{countStats && selectedGoalId && selectedGoalType === 'count'}}">
      <view class="section-header">
        <text class="section-title">计数分析</text>
        <text class="section-sub">{{countStats.days}}天总览</text>
      </view>
      <view class="count-goal-item card" wx:for="{{countStats.goalDetails}}" wx:key="id">
        <view class="cg-header">
          <view class="cg-icon-wrap" style="background: {{item.color}}20;">
            <text class="cg-icon">{{item.icon}}</text>
          </view>
          <view class="cg-info">
            <text class="cg-name">{{item.name}}</text>
            <text class="cg-detail">目标每日{{item.targetCount}}次</text>
          </view>
          <view class="cg-stat">
            <text class="cg-total">{{item.totalCheckins}}次</text>
            <text class="cg-avg">日均 {{item.avgPerDay}}次</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 日历视图 -->
    <view class="calendar card">
      <view class="calendar-header">
        <view class="nav-btn" bindtap="prevMonth">
          <text>‹</text>
        </view>
        <text class="calendar-title">{{calendarYear}}年{{calendarMonth}}月</text>
        <view class="nav-btn" bindtap="nextMonth">
          <text>›</text>
        </view>
      </view>
      <view class="calendar-weekdays">
        <text class="weekday" wx:for="{{weekdays}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="calendar-days">
        <view
          class="calendar-day {{item.empty ? 'empty' : ''}} {{item.checked ? 'checked' : ''}} {{item.isToday ? 'today' : ''}}"
          wx:for="{{calendarDays}}"
          wx:key="date"
        >
          <text class="day-number">{{item.day}}</text>
          <view class="check-dot" wx:if="{{item.checked}}"></view>
        </view>
      </view>
    </view>

    <!-- 总计 -->
    <view class="total-section card">
      <text class="total-label">累计打卡</text>
      <text class="total-value">{{totalCheckins}} 次</text>
    </view>

    <!-- 挑战勋章（全部模式） -->
    <view class="medals-section" wx:if="{{challengeMedals && !selectedGoalId}}">
      <view class="section-header">
        <text class="section-title">挑战勋章</text>
        <text class="section-sub">已获得 {{challengeMedals.unlockedCount}} 枚</text>
      </view>
      <view class="medals-grid" wx:if="{{challengeMedals.unlockedMedals.length > 0}}">
        <view class="medal-item unlocked" wx:for="{{challengeMedals.unlockedMedals}}" wx:key="id" bindtap="onMedalTap" data-medal="{{item}}">
          <view class="medal-badge">
            <text class="medal-icon">{{item.icon}}</text>
            <view class="medal-count" wx:if="{{item.count > 1}}">
              <text>×{{item.count}}</text>
            </view>
          </view>
          <text class="medal-name">{{item.name}}</text>
          <view class="medal-goals">
            <text class="medal-goal-item" wx:for="{{item.goals}}" wx:for-item="goal" wx:key="goalName">{{goal.goalIcon}}</text>
          </view>
        </view>
      </view>
      <view class="empty-medals" wx:if="{{challengeMedals.unlockedMedals.length === 0}}">
        <text class="empty-icon">🏅</text>
        <text class="empty-text">完成挑战解锁勋章</text>
      </view>
    </view>
  </block>

  <!-- ==================== 趋势视图 ==================== -->
  <block wx:if="{{statsView === 'trend'}}">
    <!-- 趋势图 -->
    <view class="trend-section card">
      <view class="section-header">
        <text class="section-title">打卡趋势</text>
        <text class="section-sub">最近30天</text>
      </view>
      <view class="trend-chart">
        <view class="trend-bar" wx:for="{{trendData}}" wx:key="date">
          <view class="trend-bar-track">
            <view class="trend-bar-fill" style="height: {{item.percent}}%;"></view>
          </view>
          <text class="trend-bar-label" wx:if="{{index % 5 === 0}}">{{item.day}}</text>
        </view>
      </view>
      <view class="trend-stats">
        <view class="trend-stat">
          <text class="trend-stat-value">{{trendAvg}}</text>
          <text class="trend-stat-label">日均打卡</text>
        </view>
        <view class="trend-stat">
          <text class="trend-stat-value">{{trendMax}}</text>
          <text class="trend-stat-label">最高</text>
        </view>
        <view class="trend-stat">
          <text class="trend-stat-value">{{trendTotal}}</text>
          <text class="trend-stat-label">总计</text>
        </view>
      </view>
    </view>

    <!-- 打卡时间分布 -->
    <view class="time-distribution card">
      <view class="section-header">
        <text class="section-title">打卡时间分布</text>
      </view>
      <view class="time-bars">
        <view class="time-bar-item" wx:for="{{timeDistribution}}" wx:key="period">
          <text class="time-period">{{item.period}}</text>
          <view class="time-bar-track">
            <view class="time-bar-fill" style="width: {{item.percent}}%;"></view>
          </view>
          <text class="time-count">{{item.count}}</text>
        </view>
      </view>
      <view class="time-summary">
        <text class="time-summary-text">你最常在{{peakPeriod}}打卡</text>
      </view>
    </view>

    <!-- 年度热力图 -->
    <view class="heatmap-section card">
      <view class="heatmap-header">
        <text class="heatmap-title">年度打卡</text>
        <view class="heatmap-nav">
          <view class="nav-btn" bindtap="prevHeatmapYear">
            <text>‹</text>
          </view>
          <text class="heatmap-year">{{heatmapYear}}</text>
          <view class="nav-btn" bindtap="nextHeatmapYear">
            <text>›</text>
          </view>
        </view>
      </view>
      <view class="heatmap-container">
        <view class="heatmap-months">
          <text class="heatmap-month" wx:for="{{heatmapMonths}}" wx:key="index">{{item}}</text>
        </view>
        <view class="heatmap-grid">
          <view class="heatmap-week" wx:for="{{heatmapData}}" wx:key="weekIndex">
            <view
              class="heatmap-day level-{{item.level}}"
              wx:for="{{item.days}}"
              wx:key="date"
              bindtap="showHeatmapDetail"
              data-date="{{item.date}}"
              data-count="{{item.count}}"
            >
              <view class="heatmap-day-inner"></view>
            </view>
          </view>
        </view>
        <view class="heatmap-legend">
          <text class="legend-text">少</text>
          <view class="legend-day level-0"></view>
          <view class="legend-day level-1"></view>
          <view class="legend-day level-2"></view>
          <view class="legend-day level-3"></view>
          <view class="legend-day level-4"></view>
          <text class="legend-text">多</text>
        </view>
      </view>
      <view class="heatmap-stats">
        <text class="heatmap-stat">全年打卡 {{heatmapTotalDays}} 天</text>
        <text class="heatmap-stat">最长连续 {{heatmapMaxStreak}} 天</text>
      </view>
    </view>
  </block>

  <!-- 勋章详情弹窗 -->
  <view class="medal-overlay" wx:if="{{showMedalDetail}}" bindtap="hideMedalDetail">
    <view class="medal-modal" catchtap>
      <view class="medal-modal-header">
        <text class="medal-modal-icon">{{selectedMedal.icon}}</text>
        <text class="medal-modal-name">{{selectedMedal.name}}</text>
        <text class="medal-modal-desc">{{selectedMedal.desc}}</text>
      </view>
      <view class="medal-modal-body">
        <view class="medal-modal-stat">
          <text class="medal-modal-count">获得 {{selectedMedal.count}} 次</text>
        </view>
        <view class="medal-modal-divider"></view>
        <text class="medal-modal-source-title">获得来源</text>
        <view class="medal-modal-goals">
          <view class="medal-modal-goal-item" wx:for="{{selectedMedal.goals}}" wx:key="goalName">
            <text class="medal-modal-goal-icon">{{item.goalIcon}}</text>
            <text class="medal-modal-goal-name">{{item.goalName}}</text>
          </view>
        </view>
      </view>
      <view class="medal-modal-footer">
        <view class="medal-modal-close-btn" bindtap="hideMedalDetail">
          <text>关闭</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 自定义TabBar -->
  <tab-bar selected="{{1}}" />
</view>
