@import "../../styles/theme.wxss";

.page-report {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
}

.loading-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

/* 年份切换 */
.year-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 24rpx;
}

.nav-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-card);
  border-radius: 50%;
  font-size: 32rpx;
  color: var(--color-text);
  box-shadow: var(--shadow-sm);
}

.year-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
}

/* 总览卡片 */
.report-hero {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 32rpx;
  text-align: center;
}

.hero-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 32rpx;
}

.hero-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-value {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
}

.hero-label {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

.hero-progress {
  text-align: center;
}

.progress-text {
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 12rpx;
  display: block;
}

.progress-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--color-bg-card);
  border-radius: 6rpx;
}

/* 通用区块 */
.report-section {
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  display: block;
  margin-bottom: 20rpx;
}

.section-highlight {
  font-size: 24rpx;
  color: var(--color-primary);
  text-align: center;
  margin-top: 16rpx;
  display: block;
}

/* 月度图表 */
.monthly-chart {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 200rpx;
  padding: 0 8rpx;
}

.month-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  height: 100%;
  justify-content: flex-end;
}

.bar-fill {
  width: 24rpx;
  background: linear-gradient(180deg, var(--color-primary), var(--color-primary-light));
  border-radius: 4rpx 4rpx 0 0;
  min-height: 4rpx;
  transition: height 0.3s ease;
}

.bar-value {
  font-size: 18rpx;
  color: var(--color-primary);
  margin-bottom: 4rpx;
}

.bar-label {
  font-size: 18rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

/* 目标排行 */
.goal-rank-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.goal-rank-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
}

.rank-index {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-primary);
  width: 40rpx;
  text-align: center;
}

.rank-icon {
  font-size: 32rpx;
}

.rank-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
}

.rank-days {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 600;
}

/* 趣味数据 */
.fun-stats {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.fun-stat {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.fun-icon {
  font-size: 32rpx;
}

.fun-text {
  font-size: 26rpx;
  color: var(--color-text);
  line-height: 1.6;
}

/* 年度总结 */
.summary-text {
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.8;
}

/* 分享按钮 */
.share-section {
  margin-top: 32rpx;
}

.btn-share {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 24rpx;
  border: none;
  box-shadow: var(--shadow-lg);
}

.btn-share::after {
  display: none;
}

.share-icon {
  font-size: 36rpx;
}
