<view class="page-insights {{themeClass}}">
  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text class="loading-text">分析中...</text>
  </view>

  <block wx:if="{{!loading}}">
    <!-- 概览卡片 -->
    <view class="overview-card card">
      <text class="overview-title">数据概览</text>
      <view class="overview-grid">
        <view class="overview-item">
          <text class="overview-value">{{overview.totalDays}}</text>
          <text class="overview-label">打卡天数</text>
        </view>
        <view class="overview-item">
          <text class="overview-value">{{overview.totalCheckins}}</text>
          <text class="overview-label">总打卡次数</text>
        </view>
        <view class="overview-item">
          <text class="overview-value">{{overview.avgPerDay}}</text>
          <text class="overview-label">日均打卡</text>
        </view>
        <view class="overview-item">
          <text class="overview-value">{{overview.completionRate}}%</text>
          <text class="overview-label">完成率</text>
        </view>
      </view>
    </view>

    <!-- 趋势分析 -->
    <view class="trend-card card">
      <text class="section-title">趋势分析</text>
      <view class="trend-content">
        <view class="trend-item">
          <text class="trend-label">本周打卡</text>
          <text class="trend-value">{{trends.thisWeek}} 次</text>
        </view>
        <view class="trend-item">
          <text class="trend-label">上周打卡</text>
          <text class="trend-value">{{trends.lastWeek}} 次</text>
        </view>
        <view class="trend-item">
          <text class="trend-label">变化</text>
          <text class="trend-value {{trends.change >= 0 ? 'positive' : 'negative'}}">
            {{trends.change >= 0 ? '+' : ''}}{{trends.change}} 次 ({{trends.changePercent}}%)
          </text>
        </view>
      </view>
    </view>

    <!-- 打卡规律 -->
    <view class="pattern-card card">
      <text class="section-title">打卡规律</text>
      <view class="pattern-list">
        <view class="pattern-item">
          <text class="pattern-icon">⏰</text>
          <view class="pattern-info">
            <text class="pattern-label">最佳打卡时间</text>
            <text class="pattern-value">{{patterns.bestHourStr}}</text>
          </view>
        </view>
        <view class="pattern-item">
          <text class="pattern-icon">📅</text>
          <view class="pattern-info">
            <text class="pattern-label">最活跃的一天</text>
            <text class="pattern-value">{{patterns.bestDay}}</text>
          </view>
        </view>
        <view class="pattern-item">
          <text class="pattern-icon">📊</text>
          <view class="pattern-info">
            <text class="pattern-label">工作日日均</text>
            <text class="pattern-value">{{patterns.weekdayAvg}} 次</text>
          </view>
        </view>
        <view class="pattern-item">
          <text class="pattern-icon">🎯</text>
          <view class="pattern-info">
            <text class="pattern-label">周末日均</text>
            <text class="pattern-value">{{patterns.weekendAvg}} 次</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 智能建议 -->
    <view class="suggestions-card card" wx:if="{{suggestions.length > 0}}">
      <text class="section-title">智能建议</text>
      <view class="suggestion-list">
        <view class="suggestion-item" wx:for="{{suggestions}}" wx:key="title">
          <text class="suggestion-icon">{{item.icon}}</text>
          <view class="suggestion-info">
            <text class="suggestion-title">{{item.title}}</text>
            <text class="suggestion-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 习惯稳定性 -->
    <view class="stability-card card" wx:if="{{stability && stability.score > 0}}">
      <text class="section-title">习惯稳定性</text>
      <view class="stability-content">
        <view class="stability-score">
          <text class="score-value">{{stability.score}}</text>
          <text class="score-label">分</text>
        </view>
        <view class="stability-info">
          <text class="stability-level">{{stability.level === 'excellent' ? '优秀' : stability.level === 'good' ? '良好' : stability.level === 'fair' ? '一般' : '需改进'}}</text>
          <text class="stability-message">{{stability.message}}</text>
        </view>
      </view>
      <view class="stability-breakdown" wx:if="{{stability.breakdown}}">
        <view class="breakdown-item" wx:for="{{stability.breakdown}}" wx:key="desc">
          <text class="breakdown-label">{{item.desc}}</text>
          <view class="breakdown-bar">
            <view class="breakdown-fill" style="width: {{item.score / item.max * 100}}%;"></view>
          </view>
          <text class="breakdown-score">{{item.score}}/{{item.max}}</text>
        </view>
      </view>
    </view>

    <!-- 对比分析 -->
    <view class="comparison-card card" wx:if="{{comparison}}">
      <text class="section-title">本周 vs 上周</text>
      <view class="comparison-content">
        <view class="comparison-item">
          <text class="comparison-label">本周打卡</text>
          <text class="comparison-value">{{comparison.thisWeek.total}} 次</text>
        </view>
        <view class="comparison-item">
          <text class="comparison-label">上周打卡</text>
          <text class="comparison-value">{{comparison.lastWeek.total}} 次</text>
        </view>
        <view class="comparison-item">
          <text class="comparison-label">变化</text>
          <text class="comparison-value {{comparison.trend === 'up' ? 'positive' : comparison.trend === 'down' ? 'negative' : ''}}">
            {{comparison.totalChange >= 0 ? '+' : ''}}{{comparison.totalChange}} 次 ({{comparison.totalChangePercent}}%)
          </text>
        </view>
      </view>
    </view>

    <!-- 最佳时段推荐 -->
    <view class="besttime-card card" wx:if="{{bestTime && bestTime.hasData}}">
      <text class="section-title">最佳打卡时段</text>
      <view class="besttime-content">
        <view class="besttime-hours">
          <view class="besttime-hour" wx:for="{{bestTime.bestHours}}" wx:key="hour">
            <text class="hour-time">{{item.timeStr}}</text>
            <text class="hour-period">{{item.period}}</text>
            <text class="hour-count">{{item.count}}次</text>
          </view>
        </view>
        <view class="besttime-suggestions" wx:if="{{bestTime.suggestions.length > 0}}">
          <view class="besttime-suggestion" wx:for="{{bestTime.suggestions}}" wx:key="*this">
            <text class="suggestion-icon">💡</text>
            <text class="suggestion-text">{{item}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 各目标分析 -->
    <view class="goals-card card" wx:if="{{goalAnalysis.length > 0}}">
      <text class="section-title">各目标分析</text>
      <view class="goal-list">
        <view class="goal-item" wx:for="{{goalAnalysis}}" wx:key="id" bindtap="goGoalDetail" data-goal-id="{{item.id}}">
          <view class="goal-left">
            <view class="goal-icon-wrap" style="background: {{item.color}}20;">
              <text class="goal-icon">{{item.icon}}</text>
            </view>
            <view class="goal-info">
              <text class="goal-name">{{item.name}}</text>
              <text class="goal-detail">累计{{item.totalDays}}天 · 日均{{item.avgPerDay}}次</text>
            </view>
          </view>
          <view class="goal-right">
            <text class="goal-recent {{item.recent7Rate >= 70 ? 'good' : item.recent7Rate >= 30 ? 'normal' : 'low'}}">
              近7天{{item.recent7}}天
            </text>
            <text class="goal-arrow">›</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 习惯健康度 -->
    <view class="health-card card" wx:if="{{habitHealth && habitHealth.hasData}}">
      <text class="section-title">习惯健康度</text>
      <view class="health-content">
        <view class="health-score-wrap">
          <view class="health-score" style="border-color: {{habitHealth.color}};">
            <text class="health-score-value" style="color: {{habitHealth.color}};">{{habitHealth.score}}</text>
            <text class="health-score-label">分</text>
          </view>
          <text class="health-level" style="color: {{habitHealth.color}};">{{habitHealth.level}}</text>
        </view>
        <view class="health-detail">
          <text class="health-advice">{{habitHealth.advice}}</text>
          <view class="health-breakdown">
            <view class="health-item">
              <text class="health-item-label">一致性</text>
              <view class="health-item-bar">
                <view class="health-item-fill" style="width: {{habitHealth.breakdown.consistency.score / habitHealth.breakdown.consistency.max * 100}}%;"></view>
              </view>
              <text class="health-item-score">{{habitHealth.breakdown.consistency.score}}/{{habitHealth.breakdown.consistency.max}}</text>
            </view>
            <view class="health-item">
              <text class="health-item-label">平衡性</text>
              <view class="health-item-bar">
                <view class="health-item-fill" style="width: {{habitHealth.breakdown.balance.score / habitHealth.breakdown.balance.max * 100}}%;"></view>
              </view>
              <text class="health-item-score">{{habitHealth.breakdown.balance.score}}/{{habitHealth.breakdown.balance.max}}</text>
            </view>
            <view class="health-item">
              <text class="health-item-label">进步性</text>
              <view class="health-item-bar">
                <view class="health-item-fill" style="width: {{habitHealth.breakdown.progress.score / habitHealth.breakdown.progress.max * 100}}%;"></view>
              </view>
              <text class="health-item-score">{{habitHealth.breakdown.progress.score}}/{{habitHealth.breakdown.progress.max}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 智能推荐 -->
    <view class="recommend-card card" wx:if="{{recommendations && recommendations.hasData}}">
      <text class="section-title">智能推荐</text>
      <view class="recommend-info">
        <text class="recommend-text">你最常在{{recommendations.bestHour}}打卡，{{recommendations.bestDay}}最活跃</text>
      </view>
      <view class="recommend-list" wx:if="{{recommendations.recommendations.length > 0}}">
        <view class="recommend-item" wx:for="{{recommendations.recommendations}}" wx:key="name">
          <text class="recommend-icon">{{item.icon}}</text>
          <view class="recommend-detail">
            <text class="recommend-name">{{item.name}}</text>
            <text class="recommend-reason">{{item.reason}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 分享按钮 -->
    <view class="share-section">
      <button class="btn-share" open-type="share">
        <text class="share-icon">📤</text>
        <text>分享我的数据洞察</text>
      </button>
    </view>
  </block>
</view>
