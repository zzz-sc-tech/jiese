@import "../../styles/theme.wxss";

.page-insights {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
}

.loading-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

/* 通用区块 */
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 20rpx;
  display: block;
}

/* 概览卡片 */
.overview-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
}

.overview-title {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 20rpx;
}

.overview-grid {
  display: flex;
  justify-content: space-around;
}

.overview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.overview-value {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1;
}

.overview-label {
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

/* 趋势分析 */
.trend-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.trend-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.trend-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.trend-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.trend-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}

.trend-value.positive {
  color: var(--color-success);
}

.trend-value.negative {
  color: var(--color-danger);
}

/* 打卡规律 */
.pattern-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.pattern-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pattern-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pattern-icon {
  font-size: 32rpx;
}

.pattern-info {
  flex: 1;
}

.pattern-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  display: block;
}

.pattern-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  display: block;
  margin-top: 4rpx;
}

/* 智能建议 */
.suggestions-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.suggestion-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.suggestion-item {
  display: flex;
  gap: 16rpx;
  padding: 16rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
}

.suggestion-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.suggestion-info {
  flex: 1;
}

.suggestion-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  display: block;
}

.suggestion-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  display: block;
  margin-top: 4rpx;
  line-height: 1.5;
}

/* 各目标分析 */
.goals-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.goal-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.goal-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
}

.goal-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.goal-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.goal-icon {
  font-size: 28rpx;
}

.goal-info {
  flex: 1;
}

.goal-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  display: block;
}

.goal-detail {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  display: block;
  margin-top: 4rpx;
}

.goal-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.goal-recent {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.goal-recent.good {
  background: rgba(91, 154, 111, 0.1);
  color: var(--color-success);
}

.goal-recent.normal {
  background: rgba(232, 184, 109, 0.1);
  color: var(--color-accent);
}

.goal-recent.low {
  background: rgba(232, 116, 97, 0.1);
  color: var(--color-danger);
}

.goal-arrow {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

/* 分享按钮 */
.share-section {
  margin-top: 32rpx;
}

.btn-share {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 24rpx;
  border: none;
  box-shadow: var(--shadow-lg);
}

.btn-share::after {
  display: none;
}

.share-icon {
  font-size: 36rpx;
}
