@import "../../styles/theme.wxss";

.page-insights {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
}

.loading-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

/* 通用区块 */
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 20rpx;
  display: block;
}

/* 概览卡片 */
.overview-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
}

.overview-title {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 20rpx;
}

.overview-grid {
  display: flex;
  justify-content: space-around;
}

.overview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.overview-value {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1;
}

.overview-label {
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

/* 趋势分析 */
.trend-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.trend-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.trend-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.trend-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.trend-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}

.trend-value.positive {
  color: var(--color-success);
}

.trend-value.negative {
  color: var(--color-danger);
}

/* 打卡规律 */
.pattern-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.pattern-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pattern-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pattern-icon {
  font-size: 32rpx;
}

.pattern-info {
  flex: 1;
}

.pattern-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  display: block;
}

.pattern-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  display: block;
  margin-top: 4rpx;
}

/* 智能建议 */
.suggestions-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.suggestion-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.suggestion-item {
  display: flex;
  gap: 16rpx;
  padding: 16rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
}

.suggestion-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.suggestion-info {
  flex: 1;
}

.suggestion-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  display: block;
}

.suggestion-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  display: block;
  margin-top: 4rpx;
  line-height: 1.5;
}

/* 习惯稳定性 */
.stability-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.stability-content {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.stability-score {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.score-value {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1;
}

.score-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.stability-info {
  flex: 1;
}

.stability-level {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  display: block;
  margin-bottom: 4rpx;
}

.stability-message {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  display: block;
}

.stability-breakdown {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}

.breakdown-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.breakdown-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  width: 80rpx;
}

.breakdown-bar {
  flex: 1;
  height: 12rpx;
  background: var(--color-border);
  border-radius: 6rpx;
  overflow: hidden;
}

.breakdown-fill {
  height: 100%;
  background: var(--color-primary);
  border-radius: 6rpx;
}

.breakdown-score {
  font-size: 22rpx;
  color: var(--color-text);
  width: 80rpx;
  text-align: right;
}

/* 对比分析 */
.comparison-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.comparison-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.comparison-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.comparison-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.comparison-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}

.comparison-value.positive {
  color: var(--color-success);
}

.comparison-value.negative {
  color: var(--color-danger);
}

/* 最佳时段推荐 */
.besttime-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.besttime-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.besttime-hours {
  display: flex;
  gap: 16rpx;
}

.besttime-hour {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
}

.hour-time {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.hour-period {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.hour-count {
  font-size: 20rpx;
  color: var(--color-primary);
  margin-top: 4rpx;
}

.besttime-suggestions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--color-border);
}

.besttime-suggestion {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.besttime-suggestion .suggestion-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

.besttime-suggestion .suggestion-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* 各目标分析 */
.goals-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.goal-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.goal-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
}

.goal-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.goal-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.goal-icon {
  font-size: 28rpx;
}

.goal-info {
  flex: 1;
}

.goal-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  display: block;
}

.goal-detail {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  display: block;
  margin-top: 4rpx;
}

.goal-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.goal-recent {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.goal-recent.good {
  background: rgba(91, 154, 111, 0.1);
  color: var(--color-success);
}

.goal-recent.normal {
  background: rgba(232, 184, 109, 0.1);
  color: var(--color-accent);
}

.goal-recent.low {
  background: rgba(232, 116, 97, 0.1);
  color: var(--color-danger);
}

.goal-arrow {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

/* 分享按钮 */
.share-section {
  margin-top: 32rpx;
}

.btn-share {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 24rpx;
  border: none;
  box-shadow: var(--shadow-lg);
}

.btn-share::after {
  display: none;
}

.share-icon {
  font-size: 36rpx;
}

/* 习惯健康度 */
.health-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.health-content {
  display: flex;
  gap: 24rpx;
}

.health-score-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.health-score {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 8rpx solid;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.health-score-value {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.health-score-label {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.health-level {
  font-size: 24rpx;
  font-weight: 600;
}

.health-detail {
  flex: 1;
}

.health-advice {
  font-size: 24rpx;
  color: var(--color-text);
  line-height: 1.6;
  display: block;
  margin-bottom: 16rpx;
}

.health-breakdown {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.health-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.health-item-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  width: 80rpx;
}

.health-item-bar {
  flex: 1;
  height: 12rpx;
  background: var(--color-border);
  border-radius: 6rpx;
  overflow: hidden;
}

.health-item-fill {
  height: 100%;
  background: var(--color-primary);
  border-radius: 6rpx;
}

.health-item-score {
  font-size: 22rpx;
  color: var(--color-text);
  width: 80rpx;
  text-align: right;
}

/* 智能推荐 */
.recommend-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.recommend-info {
  margin-bottom: 16rpx;
}

.recommend-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.recommend-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.recommend-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
}

.recommend-icon {
  font-size: 32rpx;
}

.recommend-detail {
  flex: 1;
}

.recommend-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  display: block;
}

.recommend-reason {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  display: block;
  margin-top: 4rpx;
}
