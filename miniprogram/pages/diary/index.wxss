@import "../../styles/theme.wxss";

.page-diary {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* 目标筛选 */
.goal-filter {
  margin-bottom: 24rpx;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-item {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 24rpx;
  background: var(--color-bg-card);
  font-size: 24rpx;
  color: var(--color-text-secondary);
  box-shadow: var(--shadow-sm);
  border: 2rpx solid transparent;
}

.filter-item.active {
  background: rgba(91, 154, 111, 0.1);
  border-color: var(--color-primary);
  color: var(--color-primary);
}

.filter-icon {
  font-size: 24rpx;
}

/* 加载中 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
}

.loading-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

/* 日记列表 */
.diary-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.diary-item {
  padding: 24rpx;
}

.diary-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.diary-goal {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.diary-goal-icon {
  font-size: 28rpx;
}

.diary-goal-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}

.diary-date {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.diary-mood {
  margin-bottom: 12rpx;
}

.mood-icon {
  font-size: 36rpx;
}

.diary-content {
  padding-top: 12rpx;
  border-top: 1rpx solid var(--color-border);
}

.diary-text {
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.6;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}
