<view class="page-monthly {{themeClass}}">
  <!-- 月份切换 -->
  <view class="month-nav">
    <view class="nav-btn" bindtap="prevMonth">
      <text>‹</text>
    </view>
    <text class="month-title">{{year}}年{{month}}月</text>
    <view class="nav-btn" bindtap="nextMonth">
      <text>›</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text class="loading-text">生成报告中...</text>
  </view>

  <block wx:if="{{report && !loading}}">
    <!-- 总览卡片 -->
    <view class="overview-card card">
      <text class="overview-title">月度总览</text>
      <view class="overview-grid">
        <view class="overview-item">
          <text class="overview-value">{{report.totalDays}}</text>
          <text class="overview-label">打卡天数</text>
        </view>
        <view class="overview-item">
          <text class="overview-value">{{report.completionRate}}%</text>
          <text class="overview-label">完成率</text>
        </view>
        <view class="overview-item">
          <text class="overview-value">{{report.maxStreak}}</text>
          <text class="overview-label">最长连续</text>
        </view>
        <view class="overview-item">
          <text class="overview-value">{{report.totalCheckins}}</text>
          <text class="overview-label">总打卡次数</text>
        </view>
      </view>
      <view class="overview-bar">
        <view class="overview-bar-track">
          <view class="overview-bar-fill" style="width: {{report.completionRate}}%;"></view>
        </view>
      </view>
      <text class="overview-summary">{{report.summary}}</text>
    </view>

    <!-- 每日打卡图 -->
    <view class="daily-card card">
      <text class="section-title">每日打卡</text>
      <view class="daily-grid">
        <view
          class="daily-day {{item.checked ? 'checked' : ''}}"
          wx:for="{{report.dailyData}}"
          wx:key="day"
        >
          <text class="daily-day-num">{{item.day}}</text>
        </view>
      </view>
    </view>

    <!-- 各目标统计 -->
    <view class="goals-card card" wx:if="{{report.goalStats.length > 0}}">
      <text class="section-title">各目标统计</text>
      <view class="goal-list">
        <view class="goal-item" wx:for="{{report.goalStats}}" wx:key="id">
          <view class="goal-left">
            <view class="goal-icon-wrap" style="background: {{item.color}}20;">
              <text class="goal-icon">{{item.icon}}</text>
            </view>
            <view class="goal-info">
              <text class="goal-name">{{item.name}}</text>
              <text class="goal-detail">{{item.days}}天 · {{item.count}}次</text>
            </view>
          </view>
          <view class="goal-rate">
            <text class="rate-value">{{item.rate}}%</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 趣味数据 -->
    <view class="fun-card card">
      <text class="section-title">趣味数据</text>
      <view class="fun-list">
        <view class="fun-item">
          <text class="fun-icon">⏰</text>
          <text class="fun-text">最常打卡时间：{{report.bestHour}}</text>
        </view>
        <view class="fun-item">
          <text class="fun-icon">📊</text>
          <text class="fun-text">日均打卡 {{avgPerDay}} 次</text>
        </view>
      </view>
    </view>

    <!-- 分享按钮 -->
    <view class="share-section">
      <button class="btn-share" open-type="share">
        <text class="share-icon">📤</text>
        <text>分享月度报告</text>
      </button>
    </view>
  </block>
</view>
