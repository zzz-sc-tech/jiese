@import "../../styles/theme.wxss";

.page-monthly {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* 月份切换 */
.month-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 24rpx;
}

.nav-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-card);
  border-radius: 50%;
  font-size: 32rpx;
  color: var(--color-text);
  box-shadow: var(--shadow-sm);
}

.month-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
}

/* 加载中 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
}

.loading-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

/* 总览卡片 */
.overview-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
}

.overview-title {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 20rpx;
}

.overview-grid {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.overview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.overview-value {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1;
}

.overview-label {
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

.overview-bar {
  margin-bottom: 16rpx;
}

.overview-bar-track {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 6rpx;
  overflow: hidden;
}

.overview-bar-fill {
  height: 100%;
  background: #fff;
  border-radius: 6rpx;
}

.overview-summary {
  font-size: 24rpx;
  opacity: 0.9;
  text-align: center;
}

/* 通用区块 */
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 16rpx;
  display: block;
}

/* 每日打卡图 */
.daily-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.daily-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.daily-day {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.daily-day.checked {
  background: var(--color-primary);
  color: #fff;
}

.daily-day-num {
  font-size: 20rpx;
}

/* 各目标统计 */
.goals-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.goal-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.goal-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
}

.goal-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.goal-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.goal-icon {
  font-size: 24rpx;
}

.goal-info {
  display: flex;
  flex-direction: column;
}

.goal-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}

.goal-detail {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.goal-rate {
  text-align: right;
}

.rate-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
}

/* 趣味数据 */
.fun-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.fun-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.fun-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.fun-icon {
  font-size: 28rpx;
}

.fun-text {
  font-size: 26rpx;
  color: var(--color-text);
}

/* 分享按钮 */
.share-section {
  margin-top: 32rpx;
}

.btn-share {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 24rpx;
  border: none;
  box-shadow: var(--shadow-lg);
}

.btn-share::after {
  display: none;
}

.share-icon {
  font-size: 36rpx;
}
