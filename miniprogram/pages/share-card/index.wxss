@import "../../styles/theme.wxss";

.page-share-card {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card-preview {
  margin-bottom: 48rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  border-radius: 16rpx;
  overflow: hidden;
}

.card-canvas {
  display: block;
}

.actions {
  display: flex;
  gap: 24rpx;
  width: 100%;
  margin-bottom: 24rpx;
}

.btn-save,
.btn-share {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.btn-save {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
}

.btn-save::after {
  display: none;
}

.btn-share {
  background: var(--color-bg-card);
  color: var(--color-text);
  box-shadow: var(--shadow-md);
}

.btn-share::after {
  display: none;
}

.btn-icon {
  font-size: 32rpx;
}

.tips {
  text-align: center;
}

.tip-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}
