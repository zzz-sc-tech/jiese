<view class="page-reminder {{themeClass}}">
  <!-- 目标选择 -->
  <view class="goal-selector">
    <text class="selector-label">选择目标</text>
    <scroll-view scroll-x class="goal-scroll">
      <view
        class="goal-chip {{selectedGoalId === item.id ? 'selected' : ''}}"
        wx:for="{{goals}}"
        wx:key="id"
        bindtap="selectGoal"
        data-goal-id="{{item.id}}"
      >
        <text class="chip-icon">{{item.icon}}</text>
        <text>{{item.name}}</text>
      </view>
    </scroll-view>
  </view>

  <block wx:if="{{selectedGoal}}">
    <!-- 当前提醒时间 -->
    <view class="section card">
      <view class="section-header">
        <text class="section-title">提醒时间</text>
        <view class="add-btn" bindtap="addTime">
          <text class="add-icon">+</text>
        </view>
      </view>

      <view class="time-list" wx:if="{{reminders.length > 0}}">
        <view class="time-item" wx:for="{{reminders}}" wx:key="*this">
          <text class="time-value">{{item}}</text>
          <view class="time-delete" bindtap="deleteTime" data-time="{{item}}">
            <text class="delete-icon">×</text>
          </view>
        </view>
      </view>

      <view class="empty-hint" wx:else>
        <text class="hint-text">暂未设置提醒时间</text>
      </view>
    </view>

    <!-- 智能建议 -->
    <view class="section card" wx:if="{{suggestions.length > 0}}">
      <view class="section-header">
        <text class="section-title">智能建议</text>
        <text class="section-sub">基于你的打卡习惯</text>
      </view>

      <view class="suggestion-list">
        <view class="suggestion-item" wx:for="{{suggestions}}" wx:key="time">
          <view class="suggestion-info">
            <text class="suggestion-time">{{item.time}}</text>
            <text class="suggestion-reason">{{item.reason}}</text>
            <text class="suggestion-confidence">匹配度 {{item.confidence}}%</text>
          </view>
          <view class="suggestion-btn" bindtap="useSuggestion" data-time="{{item.time}}">
            <text class="btn-text">使用</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 高级设置 -->
    <view class="section card">
      <view class="section-header">
        <text class="section-title">高级设置</text>
      </view>

      <view class="setting-item">
        <view class="setting-info">
          <text class="setting-label">仅工作日提醒</text>
          <text class="setting-desc">周六日不提醒</text>
        </view>
        <switch checked="{{selectedGoal.reminder.weekdayOnly}}" bindchange="toggleWeekdayOnly" color="var(--color-primary)" />
      </view>

      <view class="setting-item">
        <view class="setting-info">
          <text class="setting-label">仅周末提醒</text>
          <text class="setting-desc">工作日不提醒</text>
        </view>
        <switch checked="{{selectedGoal.reminder.weekendOnly}}" bindchange="toggleWeekendOnly" color="var(--color-primary)" />
      </view>
    </view>
  </block>

  <!-- 添加时间弹窗 -->
  <view class="modal-overlay" wx:if="{{showAddTime}}" bindtap="cancelAddTime">
    <view class="modal-content" catchtap>
      <view class="modal-header">
        <text class="modal-title">添加提醒时间</text>
        <view class="modal-close" bindtap="cancelAddTime">
          <text>✕</text>
        </view>
      </view>

      <view class="modal-body">
        <picker mode="time" value="{{newTime}}" bindchange="onTimeChange">
          <view class="time-picker">
            <text class="picker-value">{{newTime}}</text>
          </view>
        </picker>
      </view>

      <view class="modal-footer">
        <button class="btn-save" bindtap="confirmAddTime">确定添加</button>
      </view>
    </view>
  </view>
</view>
