@import "../../styles/theme.wxss";

.page-reminder {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx;
}

/* 目标选择 */
.goal-selector {
  margin-bottom: 24rpx;
}

.selector-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
  display: block;
}

.goal-scroll {
  white-space: nowrap;
}

.goal-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 24rpx;
  background: var(--color-bg-card);
  font-size: 24rpx;
  color: var(--color-text-secondary);
  box-shadow: var(--shadow-sm);
  border: 2rpx solid transparent;
}

.goal-chip.selected {
  background: rgba(91, 154, 111, 0.1);
  border-color: var(--color-primary);
  color: var(--color-primary);
}

.chip-icon {
  font-size: 24rpx;
}

/* 区块 */
.section {
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.section-sub {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.add-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary);
  border-radius: 50%;
}

.add-icon {
  font-size: 28rpx;
  color: #fff;
  font-weight: 700;
}

/* 时间列表 */
.time-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.time-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
}

.time-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.time-delete {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-danger);
  border-radius: 50%;
}

.delete-icon {
  font-size: 20rpx;
  color: #fff;
}

.empty-hint {
  text-align: center;
  padding: 24rpx 0;
}

.hint-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* 智能建议 */
.suggestion-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.suggestion-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
}

.suggestion-info {
  flex: 1;
}

.suggestion-time {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  display: block;
}

.suggestion-reason {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  display: block;
  margin-top: 4rpx;
}

.suggestion-confidence {
  font-size: 20rpx;
  color: var(--color-primary);
  display: block;
  margin-top: 4rpx;
}

.suggestion-btn {
  padding: 8rpx 20rpx;
  background: rgba(91, 154, 111, 0.1);
  border-radius: 16rpx;
}

.btn-text {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 500;
}

/* 设置项 */
.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-info {
  flex: 1;
}

.setting-label {
  font-size: 28rpx;
  color: var(--color-text);
  display: block;
}

.setting-desc {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  display: block;
  margin-top: 4rpx;
}

/* 弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-content {
  width: 100%;
  background: var(--color-bg-card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text);
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg);
  border-radius: 50%;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.modal-body {
  margin-bottom: 32rpx;
}

.time-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  background: var(--color-bg);
  border-radius: 16rpx;
}

.picker-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-text);
}

.btn-save {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 24rpx;
  border: none;
  box-shadow: var(--shadow-lg);
}

.btn-save::after {
  display: none;
}
